# ─────────────────────────────────────────────────────────────
# SI ACOUSTIC | R&D COMMAND CENTRE — environment configuration
# Copy to .env.local for development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# REQUIRED in production: at least 32 random characters.
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Where the JSON data store and audit log are written (must be persistent + private)
DATA_DIR=./.data

# Demo accounts (admin / manager / engineer / viewer / tv) are seeded on first run.
# Development: if unset, the documented demo password "Aura#Demo2026" is used.
# Production: you MUST set this (min 12 chars) or the demo seed refuses to run.
SEED_DEMO_PASSWORD=

# Public origin used for CSRF origin checks (no trailing slash)
APP_ORIGIN=http://localhost:3000

# ── Optional integrations (all OFF by default; never enabled silently) ──
# External AI model for AURA. Leave false unless you have API credits and approval.
# NOTE: a ChatGPT Plus/Pro or Claude Pro subscription does NOT include API credits.
AI_EXTERNAL_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Google Calendar (read-only, service account) — not yet implemented
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Google Sheets data adapter — not yet implemented
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=

# ElevenLabs narration — not yet implemented (browser speech synthesis is used)
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=

# TikTok publishing — not implemented; publishing is recorded manually after human approval
TIKTOK_ENABLED=false
